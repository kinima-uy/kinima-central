# Copiar a /etc/kinima/central.env y reemplazar los valores de ejemplo.
# Generá cada secreto con: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# Generá BACKUP_DATA_KEY como una clave de 32 bytes con: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PGUSER=kinima
PGPASSWORD=REPLACE_WITH_RANDOM_BASE64URL_SECRET
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=kinima
PGSSL=false
API_HOST=127.0.0.1
API_PORT=4174
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_BASE64URL_SECRET
BOOTSTRAP_TOKEN=REPLACE_WITH_A_ONE_TIME_RANDOM_BASE64URL_SECRET
BACKUP_DATA_KEY=REPLACE_WITH_A_SEPARATE_32_BYTE_BASE64URL_KEY
NODE_ENV=production
KINIMA_ENV_FILE=/etc/kinima/central.env
