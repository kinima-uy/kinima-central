[Unit]
Description=Kinima central API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=kinima
Group=kinima
WorkingDirectory=/opt/kinima/kinima-web
EnvironmentFile=/etc/kinima/central.env
ExecStart=/usr/bin/node /opt/kinima/kinima-web/scripts/run-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
UMask=0077

[Install]
WantedBy=multi-user.target
