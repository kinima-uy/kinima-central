# Plantilla pública. Copiala a .env en la carpeta raíz del proyecto y reemplazá todo lo indicado.
# No ingreses acá credenciales reales ni compartas el archivo .env.
KINIMA_API_BASE_URL=https://REEMPLAZAR-POR-DOMINIO-DEL-API
KINIMA_DEVICE_ID=PEGAR-ID-UUID-COPIADO-DEL-PORTAL
KINIMA_DEVICE_TOKEN=PEGAR-TOKEN-COPIADO-DEL-PORTAL
# Generá una clave aleatoria de 32 bytes en Base64 URL-safe, sin "=", como explica raspberry/README.md.
DEVICE_DATA_KEY=GENERAR-CLAVE-PRIVADA-DE-43-CARACTERES
NODE_ENV=production
DEVICE_HOST=127.0.0.1
DEVICE_PORT=4173
